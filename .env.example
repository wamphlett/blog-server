# Copy this file to .env and adjust as needed, or just run ./scripts/run.sh
# which will prompt you for each value and write .env for you.
#
# See README.md#configuration for full details on each variable.

# --- Server ---
# HOST_PORT is only used by docker-compose (host-side port mapping).
HOST_PORT=3110
PORT=3000
ALLOWED_ORIGINS=
ENVIRONMENT=development

# --- Content ---
CONTENT_PATH=./content
CONTENT_REPO=
CONTENT_BRANCH=
CONTENT_UPDATE_INTERVAL_SECONDS=300
CONTENT_ASSET_DIR=images
STATIC_ASSET_URL=images
TOPIC_FILE=README.md

# --- Cache invalidation (both required to enable) ---
BLOG_SITE_HOST=
BLOG_SITE_SECRET=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=blog-server
